# ==============================================================================
# BREGALDA - CONFERIDOR DE RAZÃO (BACKEND ENVIRONMENT CONFIGURATION)
# ==============================================================================
# O Backend atua como BFF seguro. Todas as chaves e validações residem aqui.
# ==============================================================================

# Ambiente: 'development' (permite login local simulado) ou 'production' (estrito)
ENVIRONMENT=development

# Credenciais de Servidor Supabase (Auth Zero-Storage)
# Obtenha em Project Settings -> API no painel do Supabase
SUPABASE_URL=https://exemplo.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Whitelist de E-mails Autorizados (separados por vírgula)
# Qualquer tentativa de login com outro e-mail será barrada com HTTP 403 Forbidden.
ALLOWED_EMAILS=mae@dominio.com.br,ricardo@bregalda.com.br
