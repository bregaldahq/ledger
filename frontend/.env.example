# BREGALDA - CONFERIDOR DE RAZÃO (FRONTEND ENVIRONMENT CONFIGURATION)
# ==============================================================================
# POLÍTICA DE SEGURANÇA: ZERO KEYS NO FRONTEND
# 
# O cliente web NÃO armazena nenhuma chave de API, segredo, URL de banco ou
# credencial de autenticação de terceiros. Todo o fluxo de autenticação e validação
# é operado pelo Backend-for-Frontend (BFF) em Python FastAPI.
# ==============================================================================

# URL da API FastAPI Backend (Opcional)
# Em desenvolvimento local: http://localhost:8000
# Em produção: deixe vazio se o frontend e backend estiverem sob o mesmo domínio/proxy reverso
VITE_API_URL=http://localhost:8000

